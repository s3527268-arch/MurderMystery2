                rail.Parent = btn
                corner(rail, 2)

                -- Clearly label Chroma variants in the list.
                local chromaText = (tostring(wv.key) .. " " .. tostring(wv.name)):lower()
                local isChroma = chromaText:find("chroma", 1, true) ~= nil

                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, isChroma and -92 or -30, 0, 17)
                nameLabel.Position = UDim2.fromOffset(15, 6)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Font = Enum.Font.GothamMedium
                nameLabel.TextSize = 11
                nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                nameLabel.TextTransparency = 1
                nameLabel.TextXAlignment = Enum.TextXAlignment.Left
                nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
                nameLabel.Text = wv.name
                nameLabel.ZIndex = 3
                nameLabel.Parent = btn

                local metaLabel = Instance.new("TextLabel")
                metaLabel.Size = UDim2.new(1, isChroma and -92 or -30, 0, 13)
                metaLabel.Position = UDim2.fromOffset(15, 24)
                metaLabel.BackgroundTransparency = 1
                metaLabel.Font = Enum.Font.GothamMedium
                metaLabel.TextSize = 9
                metaLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                metaLabel.TextTransparency = 1
                metaLabel.TextXAlignment = Enum.TextXAlignment.Left
                metaLabel.Text = string.upper(wv.type) .. "  •  " .. string.upper(tostring(wv.rarity or "VISUAL"))
                metaLabel.ZIndex = 3
                metaLabel.Parent = btn

                local chromaBadge
                local chromaBadgeStroke
                if isChroma then
                    chromaBadge = Instance.new("TextLabel")
                    chromaBadge.Name = "ChromaBadge"
                    chromaBadge.Size = UDim2.fromOffset(58, 20)
                    chromaBadge.Position = UDim2.new(1, -66, 0.5, -10)
                    chromaBadge.BackgroundColor3 = Color3.fromRGB(39, 24, 58)
                    chromaBadge.BackgroundTransparency = 0.08
                    chromaBadge.BorderSizePixel = 0
                    chromaBadge.Font = Enum.Font.GothamBold
                    chromaBadge.TextSize = 8
                    chromaBadge.TextColor3 = Color3.fromRGB(255, 255, 255)
                    chromaBadge.Text = "CHROMA"
                    chromaBadge.TextTransparency = 1
                    chromaBadge.ZIndex = 5
                    chromaBadge.Parent = btn
                    corner(chromaBadge, 7)

                    chromaBadgeStroke = Instance.new("UIStroke")
                    chromaBadgeStroke.Color = C.purple
                    chromaBadgeStroke.Thickness = 1
                    chromaBadgeStroke.Transparency = 0.24
                    chromaBadgeStroke.Parent = chromaBadge
                end

                local selectionFlash = Instance.new("Frame")
                selectionFlash.Name = "SelectionFlash"
                selectionFlash.Size = UDim2.new(1, 0, 1, 0)
                selectionFlash.BackgroundColor3 = C.purple
                selectionFlash.BackgroundTransparency = 1
                selectionFlash.BorderSizePixel = 0
                selectionFlash.ZIndex = 2
                selectionFlash.Parent = btn
                corner(selectionFlash, 9)

                local key, name, typ, rarity = wv.key, wv.name, wv.type, wv.rarity
                local function selectRow()
                    setSelected(key, name, typ, rarity)
                end

                btn.Activated:Connect(selectRow)
                btn.MouseEnter:Connect(function()
                    if selectedKey ~= key then
                        tween(btn, {BackgroundColor3 = C.cardHover, BackgroundTransparency = 0.08}, 0.13)
                    end
                    tween(rail, {BackgroundTransparency = selectedKey == key and 0 or 0.40}, 0.14)
                    tween(rowGradient, {Offset = Vector2.new(0.06, 0)}, 0.18, Enum.EasingStyle.Quart)
                end)
                btn.MouseLeave:Connect(function()
                    if selectedKey ~= key then
                        tween(btn, {BackgroundColor3 = C.card, BackgroundTransparency = 0.16}, 0.15)
                        tween(rail, {BackgroundTransparency = 0.76}, 0.15)
                    end
                    tween(rowGradient, {Offset = selectedKey == key and Vector2.new(0.08, 0) or Vector2.new(0, 0)}, 0.20, Enum.EasingStyle.Quart)
                end)

                local row = {
                    btn = btn,
                    key = key,
                    stroke = rowStroke,
                    rail = rail,
                    gradient = rowGradient,
                    flash = selectionFlash,
                }
                rowButtons[#rowButtons + 1] = row

                task.delay(math.min((order - 1) * 0.022, 0.3), function()
                    if not btn.Parent then return end
                    local active = selectedKey == key
                    btn.BackgroundColor3 = active and C.cardActive or C.card
                    btn.BackgroundTransparency = active and 0.02 or 0.16
                    rowStroke.Transparency = active and 0.04 or 0.34
                    rowStroke.Color = active and C.purple or C.line
                    rowGradient.Offset = Vector2.new(-0.16, 0)
                    tween(rowGradient, {Offset = Vector2.new(0, 0)}, 0.34, Enum.EasingStyle.Quart)
                    tween(rail, {BackgroundTransparency = active and 0 or 0.76}, 0.22)
                    tween(nameLabel, {TextTransparency = 0}, 0.22)
                    tween(metaLabel, {TextTransparency = 0}, 0.26)
                    if chromaBadge and chromaBadge.Parent then
                        tween(chromaBadge, {TextTransparency = 0}, 0.28)
                    end
                    updateRowVisual(row, active)
                end)
            end
        end

        emptyState.Visible = order == 0
        scroll.CanvasPosition = Vector2.new(0, 0)
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        clearSearch.Visible = searchBox.Text ~= ""
        rebuildList()
    end)

    spawnBtn.Activated:Connect(function()
        if spawning then return end
        if not selectedKey then
            tween(rootStroke, {Transparency = 0}, 0.1)
            task.delay(0.08, function()
                if rootStroke.Parent then tween(rootStroke, {Transparency = 0.12}, 0.3) end
            end)
            return
        end

        spawning = true
        spawnBtn.Active = false
        tween(spawnStroke, {Thickness = 1.5, Transparency = 0.02, Color = C.white}, 0.10, Enum.EasingStyle.Quad)
        task.delay(0.12, function()
            if spawnStroke.Parent then
                tween(spawnStroke, {Thickness = 1.2, Transparency = 0.16, Color = C.silver}, 0.30, Enum.EasingStyle.Quart)
            end
        end)
        task.spawn(function()
            runButtonLoading("SPAWNED")
            if spawnBtn.Parent then spawnBtn.Active = true end
            spawning = false
        end)

        spawnWeapon(selectedKey, selectedAmount)
    end)

    -- RightShift toggles minimized state when not typing.
    table.insert(SELF.conns, UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            setMinimized(not isMinimized)
        end
    end))

    -- Entrance animation is visual-only. It never changes root.Position or rootScale,
    -- so grabbing the header at any time cannot fight an opening tween or jump upward.
    task.defer(function()
        if not root.Parent then return end
        root.BackgroundTransparency = 0.38
        rootScale.Scale = 1
        title.TextTransparency = 1
        titleAccent.BackgroundTransparency = 1
        titleAccent.Size = UDim2.fromOffset(0, 1)
        searchShell.BackgroundTransparency = 0.42
        tabFrame.BackgroundTransparency = 0.58
        listFrame.BackgroundTransparency = 0.52

        tween(root, {BackgroundTransparency = ROOT_ALPHA}, 0.34, Enum.EasingStyle.Quart)
        tween(searchShell, {BackgroundTransparency = 0.08}, 0.42, Enum.EasingStyle.Quart)
        tween(tabFrame, {BackgroundTransparency = 0.16}, 0.46, Enum.EasingStyle.Quart)
        tween(listFrame, {BackgroundTransparency = 0.08}, 0.50, Enum.EasingStyle.Quart)
        tween(rootStroke, {Transparency = 0.02}, 0.18)
        task.delay(0.14, function()
            if rootStroke.Parent then tween(rootStroke, {Transparency = 0.12}, 0.34) end
        end)
        task.delay(0.06, function()
            if title.Parent then tween(title, {TextTransparency = 0}, 0.24, Enum.EasingStyle.Quart) end
            if titleAccent.Parent then tween(titleAccent, {Size = UDim2.fromOffset(102, 1), BackgroundTransparency = 0.28}, 0.36, Enum.EasingStyle.Quint) end
            if titleAccent.Parent then tween(titleAccent, {BackgroundTransparency = 0.28}, 0.30, Enum.EasingStyle.Quart) end
        end)
    end)

    task.spawn(rebuildList)
end


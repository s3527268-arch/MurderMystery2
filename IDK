        end
    
        if data.Rarity ~= "Godly" and data.Rarity ~= "Ancient" then
            return false
        end
    
        local itemType = tostring(data.ItemType or data.Type or ""):lower()
        return itemType == "knife" or itemType == "sword" or itemType == "gun"
    end
    

    local function fitPanelToScreen(recenter)
        if not camera then return end
        local viewport = camera.ViewportSize
        local margin = IS_MOBILE and 12 or 18
        local cap = deviceScaleCap(viewport)
        local fitScale = math.min(
            (viewport.X - margin) / PANEL_W,
            (viewport.Y - margin) / math.max(root.Size.Y.Offset, 1)
        )
        uiScale.Scale = math.clamp(math.min(fitScale, cap), IS_MOBILE and 0.20 or 0.25, cap)

        local scaledW = PANEL_W * uiScale.Scale
        local scaledH = root.Size.Y.Offset * uiScale.Scale
        if recenter then
            local startX
            if IS_MOBILE then
                startX = math.max(6, (viewport.X - scaledW) * 0.5)
            else
                startX = 14
            end
            root.Position = UDim2.fromOffset(startX, math.max(6, (viewport.Y - scaledH) * 0.5))
        else
            local p = root.AbsolutePosition
            root.Position = UDim2.fromOffset(
                math.clamp(p.X, 6, math.max(6, viewport.X - scaledW - 6)),
                math.clamp(p.Y, 6, math.max(6, viewport.Y - scaledH - 6))
            )
        end
    end

    fitPanelToScreen(true)
    if camera then

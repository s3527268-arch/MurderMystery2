        loadText.TextColor3 = Color3.fromRGB(255, 255, 255)

        local progressValues = {18, 43, 71, 100}
        local widths = {0.18, 0.43, 0.71, 1}
        for i, width in ipairs(widths) do
            loadText.Text = "SPAWNING  •  " .. progressValues[i] .. "%"
            local tw = tween(loadFill, {Size = UDim2.new(width, 0, 1, 0)}, i == #widths and 0.22 or 0.16, Enum.EasingStyle.Quart)
            tw.Completed:Wait()
        end

        loadText.Text = doneText or "SPAWNED"
        loadText.TextColor3 = Color3.fromRGB(255, 255, 255)

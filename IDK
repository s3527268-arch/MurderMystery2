    -- Drag behavior — incremental delta only.
    -- This never derives a new position from AbsolutePosition, GUI inset, or an
    -- opening animation. Each frame simply adds the pointer movement since the
    -- previous frame, so grabbing the window cannot snap it upward.
    local dragging = false
    local dragKind = nil
    local lastDragPoint = Vector2.new(0, 0)

    local function inputPoint(input)
        return Vector2.new(input.Position.X, input.Position.Y)
    end

    local function stopDragging()
        dragging = false
        dragKind = nil
    end

    dragZone.InputBegan:Connect(function(input)
        local kind = input.UserInputType
        if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        dragKind = kind
        lastDragPoint = inputPoint(input)

        -- Drag feedback is visual-only; it never touches root.Position/UIScale.
        tween(headerStroke, {Transparency = 0.08, Thickness = 1.35, Color = C.purple}, 0.12)
        tween(headerGlow, {BackgroundTransparency = 0.12}, 0.12)

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End
                or input.UserInputState == Enum.UserInputState.Cancel then
                stopDragging()
                if headerStroke.Parent then
                    tween(headerStroke, {Transparency = 0.34, Thickness = 1.1, Color = C.line}, 0.18)
                    tween(headerGlow, {BackgroundTransparency = 0.42}, 0.18)
                end
            end
        end)
    end)

    table.insert(SELF.conns, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        if dragKind == Enum.UserInputType.Touch then
            if input.UserInputType ~= Enum.UserInputType.Touch then return end
        else
            if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        end

        local point = inputPoint(input)
        local delta = point - lastDragPoint
        lastDragPoint = point

        -- Ignore impossible one-frame jumps sometimes emitted by executors/input bridges.
        if math.abs(delta.X) > 220 or math.abs(delta.Y) > 220 then
            return
        end

        local wantedX = root.Position.X.Offset + delta.X
        local wantedY = root.Position.Y.Offset + delta.Y

        local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
        local renderedSize = Vector2.new(
            PANEL_W * uiScale.Scale,
            root.Size.Y.Offset * uiScale.Scale
        )
        wantedX = math.clamp(wantedX, 6, math.max(6, viewport.X - renderedSize.X - 6))
        wantedY = math.clamp(wantedY, 6, math.max(6, viewport.Y - renderedSize.Y - 6))

        root.Position = UDim2.fromOffset(wantedX, wantedY)
    end))


    local function updateRowVisual(row, active)
        if not row or not row.btn.Parent then return end

        tween(row.btn, {
            BackgroundColor3 = active and C.cardActive or C.card,
            BackgroundTransparency = active and 0.035 or 0.16,
        }, 0.20, Enum.EasingStyle.Quart)

        tween(row.stroke, {
            Transparency = active and 0.04 or 0.34,
            Thickness = active and 1.35 or 1,
            Color = active and C.purple or C.line,
        }, 0.20, Enum.EasingStyle.Quart)

        tween(row.rail, {
            BackgroundTransparency = active and 0 or 0.76,
            Size = active and UDim2.fromOffset(3, 30) or UDim2.fromOffset(2, 22),
            Position = active and UDim2.fromOffset(6, 7) or UDim2.fromOffset(6, 11),
        }, 0.24, Enum.EasingStyle.Quint)

        if row.gradient then
            tween(row.gradient, {
                Offset = active and Vector2.new(0.08, 0) or Vector2.new(0, 0),
                Rotation = active and 102 or 110,
            }, 0.28, Enum.EasingStyle.Quart)
        end

        if active and row.flash then
            row.flash.BackgroundTransparency = 0.84
            tween(row.flash, {BackgroundTransparency = 1}, 0.42, Enum.EasingStyle.Quart)
        end
    end

